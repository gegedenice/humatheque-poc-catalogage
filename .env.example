# Copier en .env et renseigner. Valeurs FACTICES uniquement dans ce fichier.

# --- Règles de catalogage (regles/*.yaml)
REGLES_DIR=regles

# --- Extraction VLM
VLM_API_URL=https://vlm.example.org/v1/chat/completions
VLM_MODEL=google/gemma-4-26B-A4B-it
VLM_STRATEGIE=requete_unique
VLM_TIMEOUT=180
# Fournisseur par défaut : albert | vlm-local | hf | custom-hf-endpoint (modèles ouverts ;
# modèles proposés dans l'administration : config/fournisseurs.yaml)
VLM_FOURNISSEUR=albert
VLM_IMAGE_MAX_SIZE=768
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_MODEL=google/gemma-4-26B-A4B-it
HF_TOKEN=jeton-factice
# Endpoint HF dédié (fournisseur custom-hf-endpoint) : inférence OpenAI-compatible
# (jeton HF_TOKEN). Configuré en scale-to-zero (arrêt après 30 min d'inactivité) :
# un appel sur un endpoint endormi renvoie 503 et déclenche son redémarrage
# (2 à 5 min). L'API de gestion sert à afficher son état et à le réveiller ;
# avant une extraction, l'application attend qu'il soit prêt (HF_ENDPOINT_ATTENTE s).
HF_ENDPOINT_API_URL=https://mon-endpoint.endpoints.huggingface.cloud/v1/chat/completions
HF_ENDPOINT_API_MODEL=organisation/modele-GGUF
HF_ENDPOINT_NAME=nom-endpoint-factice
HF_ENDPOINT_NAMESPACE=espace-factice
HF_ENDPOINTS_API_BASE=https://api.endpoints.huggingface.cloud/v2/endpoint
HF_ENDPOINT_ATTENTE=420
ALBERT_API_URL=https://albert.api.etalab.gouv.fr/v1/chat/completions
ALBERT_MODEL=google/gemma-4-31B-it
ALBERT_API_KEY=cle-factice

# --- Services
ALMA_CHECKER_API_URL=https://alma-checker.example.org
ALMA_API_KEY=cle-factice
SUDOC_CHECKER_API_URL=https://sudoc-checker.example.org
# Les paramètres de requête des services (seuils, nombres de candidats…) sont dans
# config/services.yaml.
IDREF_QUALINKA_API_URL=https://idref-linker.example.org
IDREF_QUALINKA_API_KEY=cle-factice
DEWEY_CLASSIFICATION_API_URL=https://dewey-classifier.example.org
CLASSIFICATION_API_KEY=cle-factice
# idref-linker /align/person peut dépasser une minute
IDREF_TIMEOUT=180
# Seuil de la première classe Dewey (vide = non fixé) ; avec la méthode albert
# (reranker), les scores sont de l'ordre de 0.01, à fixer en conséquence
DEWEY_SEUIL=

# --- Exécution
CODE_ETAB=EPHE
MAX_WORKERS=2
HTTP_TIMEOUT=30
RELANCES_AUTO=2
RELANCE_DELAI=2
PROVENANCE_CONFIRMATION_LLM=false

# --- Ingestion MinIO
MINIO_ENDPOINT=https://minio.example.org
MINIO_BUCKET=bucket-factice
MINIO_PREFIXE=poc/
MINIO_ACCESS_KEY=cle-factice
MINIO_SECRET_KEY=secret-factice
# Déclencheurs automatiques : valeurs initiales, modifiables dans /admin
INGESTION_AUTO=false
BALAYAGE_INTERVALLE=60
PLANIFICATION_CRON=
EVENEMENTS_DELAI=60

# Mot de passe de l'application (vide = pas d'authentification)
MOT_DE_PASSE=
