# Copier en .env et renseigner. Valeurs FACTICES uniquement dans ce fichier.

# --- Spécification
SPEC_SOURCE=csv
GRIST_URL=http://grist:8484
GRIST_DOC_ID=identifiant-document-factice
GRIST_API_KEY=cle-api-factice
GRIST_SESSION_SECRET=secret-factice
GRIST_DEFAULT_EMAIL=admin@example.org
APP_HOME_URL=http://localhost:8484
REGLES_STATUTS_EXCLUS=rejeté

# --- Extraction VLM
VLM_API_URL=https://vlm.example.org/v1/chat/completions
VLM_MODEL=google/gemma-4-26B-A4B-it
VLM_STRATEGIE=requete_unique
VLM_TIMEOUT=180
# Fournisseur par défaut : vlm | openai | hf | albert
VLM_FOURNISSEUR=vlm
VLM_IMAGE_MAX_SIZE=768
OPENAI_API_URL=https://api.openai.com/v1/chat/completions
OPENAI_MODEL=gpt-4o
OPENAI_API_KEY=cle-factice
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_MODEL=google/gemma-4-26B-A4B-it
HF_TOKEN=jeton-factice
ALBERT_API_URL=https://albert.api.etalab.gouv.fr/v1/chat/completions
ALBERT_MODEL=mistralai/Ministral-3-8B-Instruct-2512
ALBERT_API_KEY=cle-factice

# --- Services
ALMA_CHECKER_API_URL=https://alma-checker.example.org
ALMA_API_KEY=cle-factice
SUDOC_CHECKER_API_URL=https://sudoc-checker.example.org
# Seuil de doublon Sudoc : envoyé à sudoc-checker (duplicate_threshold) et utilisé pour
# retenir les candidats lors de l'agrégation des thesis_state. Les autres paramètres
# de requête des services sont dans config/services.yaml.
SUDOC_DUPLICATE_THRESHOLD=0.78
IDREF_QUALINKA_API_URL=https://idref-linker.example.org
IDREF_QUALINKA_API_KEY=cle-factice
DEWEY_CLASSIFICATION_API_URL=https://dewey-classifier.example.org
CLASSIFICATION_API_KEY=cle-factice
# idref-linker /align/person peut dépasser une minute
IDREF_TIMEOUT=180
# Seuil de la première classe Dewey (vide = non fixé) ; avec la méthode albert
# (reranker), les scores sont de l'ordre de 0.01, à fixer en conséquence
DEWEY_SEUIL=

# --- Exécution
CODE_ETAB=EPHE
MAX_WORKERS=2
HTTP_TIMEOUT=30
RELANCES_AUTO=2
RELANCE_DELAI=2
PROVENANCE_CONFIRMATION_LLM=false

# --- Ingestion MinIO
MINIO_ENDPOINT=https://minio.example.org
MINIO_BUCKET=bucket-factice
MINIO_PREFIXE=poc/
MINIO_ACCESS_KEY=cle-factice
MINIO_SECRET_KEY=secret-factice
INGESTION_AUTO=false
PLANIFICATION_CRON=
