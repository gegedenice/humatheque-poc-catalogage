                        },
                        "description": "\"etablissement\" or \"ecole_doctorale\"."
                    },
                    {
                        "name": "parent_ppn",
                        "in": "query",
                        "required": false,
                        "schema": {
                            "type": "string",
                            "description": "Optional institution PPN scoping doctoral schools.",
                            "default": "",
                            "title": "Parent Ppn"
                        },
                        "description": "Optional institution PPN scoping doctoral schools."
                    },
                    {
                        "name": "max_results",
                        "in": "query",
