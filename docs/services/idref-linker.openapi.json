    "components": {
        "schemas": {
            "AlignOrganizationRequest": {
                "properties": {
                    "timeout": {
                        "type": "number",
                        "maximum": 120.0,
                        "exclusiveMinimum": 0.0,
                        "title": "Timeout",
                        "default": 20.0
                    },
                    "retries": {
                        "type": "integer",
                        "maximum": 10.0,
                        "minimum": 0.0,
                        "title": "Retries",
                        "default": 2
                    },
                    "backoff": {
                        "type": "number",
                        "maximum": 30.0,
                        "minimum": 0.0,
                        "title": "Backoff",
                        "default": 1.0
                    },
                    "label": {
                        "type": "string",
                        "title": "Label",
                        "description": "Extracted organization label."
                    },
                    "kind": {
                        "type": "string",
                        "title": "Kind",
                        "description": "Either \"institution\" (granting / co-tutelle) or \"doctoral_school\".",
                        "default": "institution"
                    },
                    "year": {
                        "type": "string",
                        "title": "Year",
                        "description": "Extracted defense year; disambiguates temporal versions. The extraction schema's defense_year is accepted as an alias.",
                        "default": ""
                    },
                    "parent_ppn": {
                        "type": "string",
                        "title": "Parent Ppn",
                        "description": "Optional institution PPN. For a doctoral school, restricts candidates to that institution's schools.",
                        "default": ""
                    },
                    "allow_remote": {
                        "type": "boolean",
                        "title": "Allow Remote",
                        "description": "On a local miss, fall back to a live data.idref.fr SPARQL search (covers foreign co-tutelle partners).",
                        "default": false
                    },
                    "max_candidates": {
                        "type": "integer",
                        "maximum": 50.0,
                        "minimum": 1.0,
                        "title": "Max Candidates",
                        "default": 5
                    },
                    "accept_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Accept Threshold",
                        "default": 0.72
                    },
                    "margin_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Margin Threshold",
                        "default": 0.08
                    },
                    "low_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Low Threshold",
                        "default": 0.45
                    },
                    "floor_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Floor Threshold",
                        "default": 0.3
                    }
                },
                "type": "object",
                "required": [
                    "label"
                ],
                "title": "AlignOrganizationRequest"
            },
            "AlignPersonRequest": {
                "properties": {
                    "timeout": {
                        "type": "number",
                        "maximum": 120.0,
                        "exclusiveMinimum": 0.0,
                        "title": "Timeout",
                        "default": 20.0
                    },
                    "retries": {
                        "type": "integer",
                        "maximum": 10.0,
                        "minimum": 0.0,
                        "title": "Retries",
                        "default": 2
                    },
                    "backoff": {
                        "type": "number",
                        "maximum": 30.0,
                        "minimum": 0.0,
                        "title": "Backoff",
                        "default": 1.0
                    },
                    "name": {
                        "type": "string",
                        "title": "Name",
                        "description": "Extracted full person name."
                    },
                    "first_name": {
                        "type": "string",
                        "title": "First Name",
                        "description": "Optional parsed first-name override.",
                        "default": ""
                    },
                    "last_name": {
                        "type": "string",
                        "title": "Last Name",
                        "description": "Optional parsed last-name override.",
                        "default": ""
                    },
                    "title": {
                        "type": "string",
                        "title": "Title",
                        "description": "Extracted document title.",
                        "default": ""
                    },
                    "subtitle": {
                        "type": "string",
                        "title": "Subtitle",
                        "description": "Extracted document subtitle.",
                        "default": ""
                    },
                    "discipline": {
                        "type": "string",
                        "title": "Discipline",
                        "description": "Extracted discipline.",
                        "default": ""
                    },
                    "institution": {
                        "type": "string",
                        "title": "Institution",
                        "description": "Extracted granting institution.",
                        "default": ""
                    },
                    "doctoral_school": {
                        "type": "string",
                        "title": "Doctoral School",
                        "description": "Extracted doctoral school.",
                        "default": ""
                    },
                    "degree_type": {
                        "type": "string",
                        "title": "Degree Type",
                        "description": "Extracted degree or document type.",
                        "default": ""
                    },
                    "year": {
                        "type": "string",
                        "title": "Year",
                        "description": "Extracted defense year.",
                        "default": ""
                    },
                    "max_candidates": {
                        "type": "integer",
                        "maximum": 100.0,
                        "minimum": 1.0,
                        "title": "Max Candidates",
                        "default": 20
                    },
                    "max_docs_per_role": {
                        "type": "integer",
                        "maximum": 200.0,
                        "minimum": 0.0,
                        "title": "Max Docs Per Role",
                        "default": 20
                    },
                    "reference_top_k": {
                        "type": "integer",
                        "maximum": 20.0,
                        "minimum": 1.0,
                        "title": "Reference Top K",
                        "default": 3
                    },
                    "embedding_model": {
                        "type": "string",
                        "title": "Embedding Model",
                        "description": "Optional sentence-transformers model. Leave empty for lexical token cosine similarity. Set a model name, for example sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2, to use embedding-based semantic similarity.",
                        "default": ""
                    },
                    "accept_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Accept Threshold",
                        "default": 0.65
                    },
                    "margin_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Margin Threshold",
                        "default": 0.08
                    },
                    "weight_name": {
                        "type": "number",
                        "minimum": 0.0,
                        "title": "Weight Name",
                        "default": 0.4
                    },
                    "weight_attrra_source": {
                        "type": "number",
                        "minimum": 0.0,
                        "title": "Weight Attrra Source",
                        "default": 0.25
                    },
                    "weight_attrra_note": {
                        "type": "number",
                        "minimum": 0.0,
                        "title": "Weight Attrra Note",
                        "default": 0.15
                    },
                    "weight_references": {
                        "type": "number",
                        "minimum": 0.0,
                        "title": "Weight References",
                        "default": 0.15
                    },
                    "weight_institution_year": {
                        "type": "number",
                        "minimum": 0.0,
                        "title": "Weight Institution Year",
                        "default": 0.05
                    }
                },
                "type": "object",
                "required": [
                    "name"
                ],
                "title": "AlignPersonRequest"
            },
            "AlignThesisOrganizationsRequest": {
                "properties": {
                    "timeout": {
                        "type": "number",
                        "maximum": 120.0,
                        "exclusiveMinimum": 0.0,
                        "title": "Timeout",
                        "default": 20.0
                    },
                    "retries": {
                        "type": "integer",
                        "maximum": 10.0,
                        "minimum": 0.0,
                        "title": "Retries",
                        "default": 2
                    },
                    "backoff": {
                        "type": "number",
                        "maximum": 30.0,
                        "minimum": 0.0,
                        "title": "Backoff",
                        "default": 1.0
                    },
                    "granting_institution": {
                        "type": "string",
                        "title": "Granting Institution",
                        "description": "Extracted granting institution.",
                        "default": ""
                    },
                    "co_tutelle_institutions": {
                        "items": {
                            "type": "string"
                        },
                        "type": "array",
                        "title": "Co Tutelle Institutions",
                        "description": "Extracted co-tutelle institution names."
                    },
                    "doctoral_school": {
                        "type": "string",
                        "title": "Doctoral School",
                        "description": "Extracted doctoral school.",
                        "default": ""
                    },
                    "year": {
                        "type": "string",
                        "title": "Year",
                        "description": "Extracted defense year; defense_year accepted as an alias.",
                        "default": ""
                    },
                    "allow_remote": {
                        "type": "boolean",
                        "title": "Allow Remote",
                        "description": "See AlignOrganizationRequest.allow_remote.",
                        "default": false
                    },
                    "max_candidates": {
                        "type": "integer",
                        "maximum": 50.0,
                        "minimum": 1.0,
                        "title": "Max Candidates",
                        "default": 5
                    },
                    "accept_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Accept Threshold",
                        "default": 0.72
                    },
                    "margin_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Margin Threshold",
                        "default": 0.08
                    },
                    "low_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Low Threshold",
                        "default": 0.45
                    },
                    "floor_threshold": {
                        "type": "number",
                        "maximum": 1.0,
                        "minimum": 0.0,
                        "title": "Floor Threshold",
                        "default": 0.3
                    }
                },
                "type": "object",
                "title": "AlignThesisOrganizationsRequest"
            },
            "FindPersonResponse": {
                "properties": {
                    "source": {
                        "type": "string",
                        "title": "Source"
                    },
                    "query": {
                        "additionalProperties": true,
                        "type": "object",
                        "title": "Query"
                    },
                    "found": {
                        "type": "integer",
                        "title": "Found"
                    },
                    "returned": {
                        "type": "integer",
                        "title": "Returned"
                    },
                    "results": {
                        "items": {
                            "additionalProperties": true,
                            "type": "object"
